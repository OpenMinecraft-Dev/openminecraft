#include "basics/structs/camera.gsl"
#include "basics/structs/lighting.gsl"

struct ObjectInfo {
    mat4 model;
};

[[vertex_struct]] struct ObjectVertex;

[[location(0), transfer]] vec2 objTexCoord;
[[location(1), transfer]] vec3 objNormal;
[[vposition, out]] vec4 vertexPos;
[[location(0), out]] vec4 outColor;

[[binding(0)]] ObjectInfo ubo;
[[binding(1)]] Camera camera;
[[binding(2)]] Lighting lighting;
[[binding(3)]] sampler2DArray inTexture;

[[stage(vertex)]]
void vertMain(ObjectVertex v)
{
    vertexPos = camera.viewProj * ubo.model * vec4(v.inPosition, 1.0);
    objTexCoord = v.inTexCoord;
    objNormal = normalize(mat3(ubo.model) * v.inNormal);
}

[[stage(fragment)]]
void fragMain()
{
    float diff = max(dot(normalize(objNormal), lighting.lightDirection), 0.0);
    vec3 diffuse = diff * lighting.lightColor;

    vec4 texColor = inTexture.sample(vec3(objTexCoord, 0));
    vec3 result = (lighting.ambientColor + diffuse) * texColor.rgb;

    outColor = vec4(result, texColor.a);

    #if 0 && GSL_BACKEND_VULKAN
    #error "not supported!"
    #endif
}
